{"id": "oos-04", "category": "out_of_scope", "expectation": "refuse", "question": "Who won the World Cup in 2018?", "expected_breed": null, "ground_truth": null}
# --- nonexistent_breed: plausible-sounding but not a real / in-corpus breed ---
